# Lucky Server 配置说明
# 复制此文件为 .env，然后填入实际值

# SMTP（阿里云邮件推送）
LUCKY_SMTP_USERNAME=noreply@mail.你的域名.com
LUCKY_SMTP_PASSWORD=你的SMTP密码
LUCKY_SMTP_FROM=Lucky
LUCKY_SMTP_HOST=smtpdm.aliyun.com
LUCKY_SMTP_PORT=465

# JWT 密钥（部署时务必修改！至少 32 位）
LUCKY_JWT_SECRET=your-production-secret-key-here-at-least-32-chars

# 服务端口（默认 8080，一般不用改）
LUCKY_PORT=8080
